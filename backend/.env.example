# Local development template. Production deployments must inject their own values.
# CORS_ORIGINS is only needed for a browser client; native Android requests do not send Origin.
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
MONGODB_URI=mongodb://127.0.0.1:27017/self-smart-checkout

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-before-running
# Development/demo staff only. Set unique local passwords (12–72 bytes) in backend/.env.
DEMO_GUARD_NAME=SRHU Guard
DEMO_GUARD_EMAIL=guard@srhu.demo
DEMO_GUARD_PASSWORD=
DEMO_GUARD_SHOP_ID=SHOP_001
DEMO_SALESMAN_NAME=SRHU Store Admin
DEMO_SALESMAN_EMAIL=admin@srhu.demo
DEMO_SALESMAN_PASSWORD=
DEMO_SALESMAN_SHOP_ID=SHOP_001
# Optional backwards-compatible shared password if role-specific values are blank.
DEMO_ACCOUNT_PASSWORD=
# Test-only checkout simulation; no payment provider or card details are used.
PAYMENT_MODE=sandbox
CHECKOUT_TAX_RATE_BPS=0
CHECKOUT_DISCOUNT_RATE_BPS=0
EXIT_PASS_TTL_MINUTES=15
# Optional development/demo Exit QR seed target.
DEMO_EXIT_SHOP_ID=SHOP_001
